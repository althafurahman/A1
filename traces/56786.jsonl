time, date, timedelta\n\nshutil.copy(INIT, OUT)\n\nvals = openpyxl.load_workbook(INIT, data_only=True)\nwb = openpyxl.load_workbook(OUT)\n\nsheet_name = wb.active.title\nvws = vals[sheet_name]\nws = wb[sheet_name]\n\ndef to_datetime(v):\n    if v is None:\n        return None\n    if isinstance(v, datetime):\n        if v.tzinfo is not None:\n            v = v.replace(tzinfo=None)\n        return v\n    if isinstance(v, date):\n        return datetime(v.year, v.month, v.day)\n    if isinstance(v, (int, float)):\n        try:\n            return datetime(1899, 12, 30) + timedelta(days=float(v))\n        except Exception:\n            return None\n    if isinstance(v, str):\n        s = v.strip()\n        if not s:\n            return None\n        for fmt in (\n            \"%Y-%m-%d %H:%M:%S\",\n            \"%Y-%m-%d\",\n            \"%m/%d/%Y %H:%M:%S\",\n            \"%m/%d/%Y\",\n            \"%d/%m/%Y\",\n        ):\n            try:\n                return datetime.strptime(s, fmt)\n            except ValueError:\n                pass\n    return None\n\ndef to_number(v):\n    if v is None:\n        return None\n    if isinstance(v, bool):\n        return float(v)\n    if isinstance(v, (int, float)):\n        return float(v)\n    if isinstance(v, str):\n        s = v.strip()\n        if not s:\n            return None\n        try:\n            return float(s)\n        except ValueError:\n            return None\n    return None\n\nSTART, END = 4, 200\n\ndates = {}\nvalues = {}\nfor r in range(START, END + 1):\n    dates[r] = to_datetime(vws.cell(row=r, column=1).value)\n    values[r] = to_number(vws.cell(row=r, column=2).value)\n\nfilled = 0\nfor r in range(START, END + 1):\n    cur = dates[r]\n    if cur is None:\n        ws.cell(row=r, column=3).value = None\n        continue\n\n    cutoff = cur - timedelta(days=365)\n    total = 0.0\n    count = 0\n\n    for prev in range(START, r):\n        d = dates[prev]\n        b = values[prev]\n        if d is None or b is None:\n            continue\n        if d >= cutoff:\n            total += b\n            count += 1\n\n    if count:\n        ws.cell(row=r, column=3).value = total / count\n        filled += 1\n    else:\n        ws.cell(row=r, column=3).value = None\n\nwb.save(OUT)\n\nprint(\"sheet:\", sheet_name, \"filled:\", filled)\nfor r in (4, 5, 70, 71, 72, 80, 99, 200):\n    print(r, ws.cell(row=r, column=3).value)\n```", "input_tokens": 9468, "output_tokens": 14180, "latency_ms": 221528, "error": null, "phase": "code"}
