olumn=1).value\n    year = ws2.cell(row=r, column=2).value\n\n    if state is None or year is None:\n        ws2.cell(row=r, column=4).value = None\n        continue\n\n    try:\n        y = int(float(year))\n    except (TypeError, ValueError):\n        y = None\n\n    skey = str(state).strip().upper()\n\n    if skey in state_row and y in year_col:\n        val = ws1.cell(row=state_row[skey], column=year_col[y]).value\n        ws2.cell(row=r, column=4).value = val\n        filled += 1\n    else:\n        ws2.cell(row=r, column=4).value = None\n\nprint(\"state_col:\", state_col)\nprint(\"year_cols:\", year_col)\nprint(\"filled:\", filled)\nprint(\"D3:\", ws2.cell(row=3, column=4).value)\nprint(\"D54:\", ws2.cell(row=54, column=4).value)\n\nwb.save(OUT)\n```", "input_tokens": 9325, "output_tokens": 5397, "latency_ms": 98411, "error": null, "phase": "code"}
