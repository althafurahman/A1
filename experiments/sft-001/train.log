Load the SwiftMD sheet and group rows with Duplicate? = Yes by last name, first name, and DOB. For any group with more than one row and no Employee relationship, mark one duplicate (the last occurrence) for deletion. Rewrite B2:O42 with the header and remaining rows in original order, leaving trailing cells empty.

```python
import shutil
import openpyxl
from datetime import datetime, date

try:
    from openpyxl.utils.datetime import from_excel
except Exception:
    from_excel = None

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

SHEET = "SwiftMD"
vws = vals[SHEET]
ws = wb[SHEET]

COLS = list(range(2, 16))  # B through O

def clean(v):
    if v is None:
        return None
    if isinstance(v, str):
        s = v.strip()
        return s if s else None
    return v

def norm_dob(v):
    if isinstance(v, datetime):
        return v
    if isinstance(v, date):
        return datetime(v.year, v.month, v.day)
    if isinstance(v, str):
        s = v.strip()
        if not s:
            return None
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d", "%m/%d/%Y %H:%M:%S", "%m/%d/%Y"):
            try:
                return datetime.strptime(s, fmt)
            except ValueError:
                pass
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        if v == 0:
            return None
        if v > 10000 and from_excel is not None:
            try:
                return from_excel(v)
            except Exception:
                pass
        return v
    return v

# Keep header row in the answer region.
for c in COLS:
    ws.cell(row=2, column=c).value = clean(vws.cell(row=2, column=c).value)

# Read original data rows 3-42.
rows = []
for r in range(3, 43):
    raw = [vws.cell(row=r, column=c).value for c in COLS]
    row = [clean(v) for v in raw]
    dob = norm_dob(raw[4])
    row[4] = clean(dob) if dob is not None else None
    rows.append(row)

def name_key(v):
    if isinstance(v, str):
        return v.strip().lower()
    return v

# Group only rows flagged as duplicates.
groups = {}
for i, row in enumerate(rows):
    dup = row[5]
    if isinstance(dup, str) and dup.strip().lower() == "yes":
        dob = row[4]
        dob_key = dob.date() if isinstance(dob, datetime) else dob
        key = (name_key(row[1]), name_key(row[2]), dob_key)
        groups.setdefault(key, []).append(i)

# Delete one entry per qualifying duplicate group.
delete = set()
for idxs in groups.values():
    if len(idxs) > 1:
        all_non_employee = True
        for i in idxs:
            rel = rows[i][6]
            if isinstance(rel, str) and rel.strip().lower() == "employee":
                all_non_employee = False
                break
        if all_non_employee:
            delete.add(idxs[-1])

# Write remaining rows, shifted upward.
out_r = 3
for i, row in enumerate(rows):
    if i in delete:
        continue
    for c, val in zip(COLS, row):
        ws.cell(row=out_r, column=c).value = val
    out_r += 1

# Clear any leftover answer-region rows.
for r in range(out_r, 43):
    for c in COLS:
        ws.cell(row=r, column=c).value = None

wb.save(OUT)

print("deleted", len(delete))
print("output_data_rows", out_r - 3)
print("sample", [ws.cell(row=3, column=c).value for c in (3, 4, 5, 8)])
```<|im_end|>
