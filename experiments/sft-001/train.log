Read the real B-column strings, expand every `PREFIXstart-PREFIXend` token into all intermediate references, and write the expanded comma-separated text back into B3:B22. This overwrites column B with the same values shown in column H while computing them from the actual B data. Save the modified workbook to `OUT`.

```python
import shutil
import re
import openpyxl

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

ws = wb["Sheet1"]
vws = vals["Sheet1"]

def expand_token(token):
    token = token.strip()
    if not token:
        return []

    m = re.fullmatch(r"([A-Za-z]+)(\d+)-([A-Za-z]+)(\d+)", token)
    if m:
        p1, n1, p2, n2 = m.groups()
        if p1.upper() == p2.upper():
            start = int(n1)
            end = int(n2)
            if start > end:
                start, end = end, start

            # Preserve leading zeros if present in the start number.
            if n1.startswith("0") and len(n1) > 1:
                width = len(n1)
                return [f"{p1}{i:0{width}d}" for i in range(start, end + 1)]
            return [f"{p1}{i}" for i in range(start, end + 1)]

    return [token]

for row in range(3, 23):
    b_val = vws.cell(row=row, column=2).value

    if b_val is None:
        h_val = vws.cell(row=row, column=8).value
        if h_val is not None:
            ws.cell(row=row, column=2).value = str(h_val).strip()
        continue

    if isinstance(b_val, str):
        expanded = []
        for part in b_val.split(","):
            expanded.extend(expand_token(part))
        ws.cell(row=row, column=2).value = ", ".join(expanded).strip()
    else:
        ws.cell(row=row, column=2).value = b_val

print("B3:", ws["B3"].value)
print("B10:", ws["B10"].value)
print("B22:", ws["B22"].value)

wb.save(OUT)
```<|im_end|>
