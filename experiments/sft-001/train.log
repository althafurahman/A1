Copy the workbook, read cached values from the active sheet, and count values >100 for the asset in L2 whose header dates are >=M1 and <N1. Write that integer count into M2. Save the updated workbook.

```python
import shutil
import openpyxl
from datetime import datetime, date, timedelta

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

ws = wb.active
vws = vals[ws.title]

def to_datetime(value):
    if value is None:
        return None
    if isinstance(value, datetime):
        return value
    if isinstance(value, date):
        return datetime(value.year, value.month, value.day)
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        try:
            return datetime(1899, 12, 30) + timedelta(days=float(value))
        except Exception:
            return None
    s = str(value).strip()
    if not s:
        return None
    try:
        return datetime.fromisoformat(s)
    except Exception:
        pass
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d", "%m/%d/%Y", "%d/%m/%Y"):
        try:
            return datetime.strptime(s, fmt)
        except Exception:
            pass
    return None

start = to_datetime(vws["M1"].value)
end = to_datetime(vws["N1"].value)
target_raw = vws["L2"].value
target = None if target_raw is None else str(target_raw).strip()

count = 0
matched_rows = []

for r in range(2, 12):
    asset_raw = vws.cell(row=r, column=1).value
    asset = "" if asset_raw is None else str(asset_raw).strip()

    if target is None:
        if asset != "":
            continue
    else:
        if asset != target:
            continue

    matched_rows.append(r)

    for c in range(2, 11):
        d = to_datetime(vws.cell(row=1, column=c).value)
        value = vws.cell(row=r, column=c).value

        if isinstance(value, bool):
            continue
        try:
            num = float(value)
        except Exception:
            continue

        if (
            num > 100
            and d is not None
            and start is not None
            and d >= start
            and (end is None or d < end)
        ):
            count += 1

ws["M2"] = count
wb.save(OUT)

print("sheet:", ws.title)
print("target:", target)
print("start:", start)
print("end:", end)
print("matched rows:", matched_rows)
print("M2 count:", count)
```<|im_end|>
