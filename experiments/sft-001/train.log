    if isinstance(v, int):
        return v
    if isinstance(v, float):
        return int(v) if v.is_integer() else v
    s = str(v).strip()
    if s == "":
        return None
    try:
        f = float(s)
        return int(f) if f.is_integer() else f
    except ValueError:
        return s


results = {}

for r in range(2, ws_dati.max_row + 1):
    id_val = ws_dati.cell(row=r, column=11).value  # K
    score_val = ws_dati.cell(row=r, column=10).value  # J

    key = norm_id(id_val)
    if key is None:
        continue

    if isinstance(score_val, str):
        score_val = score_val.strip()
        if score_val == "":
            continue
    if score_val is None:
        continue

    results.setdefault(key, []).append(score_val)


for r in range(2, 19):
    id_val = ws_out.cell(row=r, column=5).value  # E
    key = norm_id(id_val)

    if key is None:
        for c in range(7, 17):  # G:P
            ws_out.cell(row=r, column=c).value = None
        continue

    scores = results.get(key, [])
    last10 = scores[-10:]

    if len(last10) < 10:
        last10 = [None] * (10 - len(last10)) + last10

    for i, val in enumerate(last10):
        if isinstance(val, str):
            val = val.strip()
            if val == "":
                val = None
        ws_out.cell(row=r, column=7 + i).value = val  # G..P


print("G2:G18 =", [ws_out.cell(row=r, column=7).value for r in range(2, 19)])
print("Row2 G:P =", [ws_out.cell(row=2, column=c).value for c in range(7, 17)])
print("Row3 G:P =", [ws_out.cell(row=3, column=c).value for c in range(7, 17)])

wb.save(OUT)
