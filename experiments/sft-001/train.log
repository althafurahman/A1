Read the Data sheet's item rows and date header columns, converting headers to real datetimes. Clear the Transpose answer region and write one row per item-date pair in Data order, using the cached quantity (0 for blanks). Save the workbook with plain values in Transpose!A3:C970.

```python
import shutil
import openpyxl
import datetime

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

dws = vals["Data"]
tws = wb["Transpose"] if "Transpose" in wb.sheetnames else wb.create_sheet("Transpose")

def to_datetime(v):
    if v is None:
        return None
    if isinstance(v, datetime.datetime):
        return v
    if isinstance(v, datetime.date):
        return datetime.datetime(v.year, v.month, v.day)
    if isinstance(v, (int, float)):
        try:
            return datetime.datetime(1899, 12, 30) + datetime.timedelta(days=float(v))
        except Exception:
            return None
    if isinstance(v, str):
        s = v.strip()
        if not s:
            return None
        formats = [
            "%Y-%m-%d %H:%M:%S",
            "%Y-%m-%d %H:%M",
            "%Y-%m-%d",
            "%Y/%m/%d %H:%M:%S",
            "%Y/%m/%d",
            "%m/%d/%Y %H:%M:%S",
            "%m/%d/%Y",
            "%d-%m-%Y",
        ]
        for fmt in formats:
            try:
                return datetime.datetime.strptime(s, fmt)
            except ValueError:
                pass
        try:
            return datetime.datetime.fromisoformat(s)
        except Exception:
            pass
        try:
            f = float(s)
            return datetime.datetime(1899, 12, 30) + datetime.timedelta(days=f)
        except Exception:
            pass
    return None

def to_number(v):
    if v is None:
        return 0
    if isinstance(v, bool):
        return int(v)
    if isinstance(v, (int, float)):
        if isinstance(v, float) and v.is_integer():
            return int(v)
        return v
    if isinstance(v, str):
        s = v.strip().replace(",", "")
        if not s:
            return 0
        try:
            f = float(s)
            return int(f) if f.is_integer() else f
        except ValueError:
            return v.strip()
    return v

def normalize_item(v):
    if v is None:
        return None
    if isinstance(v, str):
        v = v.strip()
        if not v:
            return None
    if isinstance(v, float) and v.is_integer():
        v = int(v)
    return v

# Date columns are G through AX (columns 7 through 50) in the Data sheet.
date_cols = []
for c in range(7, 51):
    h = dws.cell(row=6, column=c).value
    dt = to_datetime(h)
    if dt is not None:
        date_cols.append((c, dt))

# Item rows start at row 7.
item_rows = []
for r in range(7, dws.max_row + 1):
    item = normalize_item(dws.cell(row=r, column=1).value)
    if item is not None:
        item_rows.append((r, item))

# Clear the graded answer region.
for r in range(3, 971):
    for c in range(1, 4):
        tws.cell(row=r, column=c).value = None

out_r = 3
for r, item in item_rows:
    for c, dt in date_cols:
        if out_r > 970:
            break
        qty = to_number(dws.cell(row=r, column=c).value)

        tws.cell(row=out_r, column=1).value = item

        date_cell = tws.cell(row=out_r, column=2)
        date_cell.value = dt
        date_cell.number_format = "yyyy-mm-dd hh:mm:ss"

        tws.cell(row=out_r, column=3).value = qty
        out_r += 1
    if out_r > 970:
        break

written = out_r - 3
print("date_cols:", len(date_cols), "item_rows:", len(item_rows), "written:", written)
if written:
    print("first:", tws.cell(row=3, column=1).value, tws.cell(row=3, column=2).value, tws.cell(row=3, column=3).value)
    print("last:", tws.cell(row=out_r - 1, column=1).value, tws.cell(row=out_r - 1, column=2).value, tws.cell(row=out_r - 1, column=3).value)

wb.save(OUT)
```<|im_end|>
