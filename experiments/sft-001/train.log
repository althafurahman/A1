Load the cached workbook, identify the time rows by the “Time (Mins)” label, and filter each 3-row block by the C4:C5 date range. For each data column whose row-16 header is SETUP or RUN, add the time value to the matching machine row in C10:D12. Write the six computed sums as plain numbers.

```python
import shutil
import openpyxl
from datetime import datetime, date, timedelta

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

sheet_name = wb.active.title
ws = wb[sheet_name]
vws = vals[sheet_name]

def to_date(v):
    if v is None:
        return None
    if isinstance(v, datetime):
        return v.date()
    if isinstance(v, date):
        return v
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        try:
            return (datetime(1899, 12, 30) + timedelta(days=float(v))).date()
        except Exception:
            return None
    if isinstance(v, str):
        s = v.strip()
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d", "%m/%d/%Y", "%d/%m/%Y", "%Y/%m/%d"):
            try:
                return datetime.strptime(s, fmt).date()
            except Exception:
                pass
    return None

start = to_date(vws["C4"].value)
end = to_date(vws["C5"].value)

c_phase = vws["C9"].value
d_phase = vws["D9"].value
c_phase = str(c_phase).strip().upper() if c_phase is not None else ""
d_phase = str(d_phase).strip().upper() if d_phase is not None else ""

machines = []
for r in range(10, 13):
    m = vws.cell(row=r, column=2).value
    if m is not None and str(m).strip():
        machines.append((r, str(m).strip()))

totals = {(r, c): 0.0 for r, _ in machines for c in (3, 4)}

phase_cols = []
for col in range(1, vws.max_column + 1):
    ph = vws.cell(row=16, column=col).value
    if ph is None:
        continue
    ph = str(ph).strip().upper()
    if ph == c_phase:
        phase_cols.append((col, 3))
    elif ph == d_phase:
        phase_cols.append((col, 4))

for r in range(17, vws.max_row + 1):
    metric = vws.cell(row=r, column=11).value
    if metric is None:
        continue
    metric_s = str(metric).strip().lower()
    if not ("time" in metric_s and "min" in metric_s):
        continue

    machine_row = r - 2
    if machine_row < 1:
        continue

    d1 = to_date(vws.cell(row=r, column=9).value)
    d2 = to_date(vws.cell(row=r, column=10).value)

    if d1 is None:
        d1 = to_date(vws.cell(row=machine_row, column=9).value)
    if d2 is None:
        d2 = to_date(vws.cell(row=machine_row, column=10).value)

    if start is not None and (d1 is None or d1 < start):
        continue
    if end is not None and (d2 is None or d2 > end):
        continue

    for col, sum_col in phase_cols:
        machine = vws.cell(row=machine_row, column=col).value
        if machine is None:
            continue
        machine = str(machine).strip()

        tv = vws.cell(row=r, column=col).value
        if tv is None:
            continue
        try:
            tv = float(tv)
        except Exception:
            continue

        for sr, sm in machines:
            if sm == machine:
                totals[(sr, sum_col)] += tv
                break

for (r, c), val in totals.items():
    if val == int(val):
        ws.cell(row=r, column=c).value = int(val)
    else:
        ws.cell(row=r, column=c).value = round(val, 2)

wb.save(OUT)

print("start", start, "end", end)
print("totals", {f"{openpyxl.utils.get_column_letter(c)}{r}": v for (r, c), v in sorted(totals.items())})
```<|im_end|>
