Read the type/account table from the active sheet and build an exact-match lookup from TYPE to Accounts. For each label in D2:D17, write the corresponding exact-match account total into F2:F17, excluding substring matches. Save the workbook with only those answer cells changed.

```python
import shutil
import openpyxl

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

ws = wb.active
vws = vals[ws.title]

def to_number(x):
    if isinstance(x, bool):
        return None
    if isinstance(x, (int, float)):
        return x
    if isinstance(x, str):
        s = x.strip().replace(",", "")
        try:
            return float(s)
        except Exception:
            return None
    return None

lookup = {}
for r in range(2, 18):
    a = vws.cell(row=r, column=1).value
    b = to_number(vws.cell(row=r, column=2).value)
    if a is None:
        continue
    key = str(a).strip().lower()
    if b is not None:
        lookup[key] = lookup.get(key, 0) + b

total = 0
for r in range(2, 18):
    d = vws.cell(row=r, column=4).value
    if d is None:
        val = 0
    else:
        key = str(d).strip().lower()
        val = lookup.get(key, 0)

    if isinstance(val, float) and val.is_integer():
        val = int(val)

    ws.cell(row=r, column=6).value = val
    total += val

print("answer_rows=16")
print("total=", total)
print("travel_agency_F16=", ws.cell(row=16, column=6).value)
print("online_travel_agency_F11=", ws.cell(row=11, column=6).value)

wb.save(OUT)
```<|im_end|>
