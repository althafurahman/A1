<think>

</think>

I will read the cached values from Munka1 and treat each comment as a string of tokens separated by non-letter/digit characters. For each of G2:G5, I will find the first ID whose comment contains both parameters as whole tokens, using case-insensitive matching. I will write those IDs as plain values, leaving unmatched cells empty.

```python
import shutil
import re
import openpyxl

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

data_ws = vals["Munka1"]
ans_ws = wb["Munka1"]

def clean(v):
    if v is None:
        return ""
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v).strip()

pattern_cache = {}

def has_param(comment, param):
    if not param:
        return True
    pat = pattern_cache.get(param)
    if pat is None:
        # Boundary: previous/next character must not be a Unicode letter/digit.
        # Underscore is treated as a boundary, while dashes/slashes/spaces are separators.
        pat = re.compile(
            r"(?<![^\W_])" + re.escape(param) + r"(?![^\W_])",
            re.IGNORECASE
        )
        pattern_cache[param] = pat
    return pat.search(comment) is not None

max_row = data_ws.max_row
print("max_row:", max_row)

for q in range(2, 6):
    p1 = clean(data_ws.cell(row=q, column=5).value)
    p2 = clean(data_ws.cell(row=q, column=6).value)
    params = [p for p in (p1, p2) if p]

    found = None
    if params:
        for r in range(2, max_row + 1):
            comment = clean(data_ws.cell(row=r, column=2).value)
            if not comment:
                continue

            if all(has_param(comment, p) for p in params):
                found = data_ws.cell(row=r, column=1).value
                if found is not None:
                    if isinstance(found, str):
                        found = found.strip()
                    break

    ans_ws.cell(row=q, column=7).value = found
    print(q, params, "->", found)

wb.save(OUT)
```<|im_end|>
