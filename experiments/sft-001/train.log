<think>

</think>

Plan: compute, for each customer, the non-US country with the maximum invoice amount in column B. Then fill D with C for non-US rows and with that customer’s best non-US country for US rows. Write plain values into the active sheet’s D2:D27.

```python
import shutil
import openpyxl

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)

sheet_name = wb.active.title
vws = vals[sheet_name]
ws = wb[sheet_name]

max_row = vws.max_row

best_country = {}

# First pass: find the non-US country with the highest B value for each customer.
for r in range(2, max_row + 1):
    customer = vws.cell(row=r, column=1).value
    amount = vws.cell(row=r, column=2).value
    country = vws.cell(row=r, column=3).value

    country_str = str(country).strip() if country is not None else ""

    if country_str == "US":
        continue

    if customer is None:
        continue

    if amount is None or isinstance(amount, bool):
        continue

    try:
        amount_num = float(amount)
    except (TypeError, ValueError):
        continue

    if customer not in best_country or amount_num > best_country[customer][0]:
        best_country[customer] = (amount_num, country_str)

# Second pass: write the required values into column D.
for r in range(2, max_row + 1):
    customer = vws.cell(row=r, column=1).value
    country = vws.cell(row=r, column=3).value
    country_str = str(country).strip() if country is not None else ""

    if country_str == "US":
        value = best_country.get(customer, (None, None))[1]
    else:
        value = country_str if country_str else None

    ws.cell(row=r, column=4).value = value

wb.save(OUT)

print("Sheet:", sheet_name)
print("Rows processed:", max(0, max_row - 1))
print("Best countries:", {k: v[1] for k, v in best_country.items()})
```<|im_end|>
