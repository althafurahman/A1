from copy import copy

shutil.copy(INIT, OUT)

vals = openpyxl.load_workbook(INIT, data_only=True)
wb = openpyxl.load_workbook(OUT)
ws = wb.active
vws = vals[ws.title]

def copy_style(src, dst):
    for attr in ("font", "border", "fill", "number_format", "protection", "alignment"):
        setattr(dst, attr, copy(getattr(src, attr)))

# Add the requested header; only G2:G16 are graded.
ws["G1"] = "Test"
copy_style(ws["F1"], ws["G1"])

# Match column width if column F has an explicit width.
if "F" in ws.column_dimensions and ws.column_dimensions["F"].width:
    ws.column_dimensions["G"].width = ws.column_dimensions["F"].width

x_count = 0
for r in range(2, 17):
    src = ws.cell(row=r, column=6)
    dst = ws.cell(row=r, column=7)
    copy_style(src, dst)

    category = vws.cell(row=r, column=6).value
    if category is not None and str(category).strip() == "Covid Test":
        dst.value = "X"
        x_count += 1
    else:
        dst.value = None

wb.save(OUT)

print("X count:", x_count)
print("G2:G16:", [ws.cell(row=r, column=7).value for r in range(2, 17)])
```<|im_end|>
